# ============================================================
# Ghost Data Still Exists — .gitignore
# ============================================================

# ----- Python -----
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.egg-link
pip-wheel-metadata/

# ----- Virtual environments -----
.venv/
venv/
env/
ENV/
.env.local
.env.*.local

# ----- Secrets & credentials -----
.env
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json

# ----- IDE / Editor -----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- Dataset (large, not for submission) -----
dataset/

# ----- Output artifacts (regenerated by running main.py) -----
# output.csv is KEPT because it is a required submission artifact
# code.zip is KEPT for submission packaging
# Uncomment if you want to exclude them from git history:
# output.csv
# code.zip

# ----- Jupyter notebooks -----
.ipynb_checkpoints/
*.ipynb

# ----- OS -----
.DS_Store
desktop.ini
ehthumbs.db

# ----- Logs (except the required log.txt) -----
*.log
!log.txt

# ----- Test / debug scratch files -----
code/debug*.py
code/check_*.py
code/write_*.py

# ----- Build / packaging caches -----
*.tar.gz
*.tgz
*.7z
*.rar
# nested archives inside code.zip would cause rejection:
# *.zip   ← do NOT gitignore code.zip; it is the submission
